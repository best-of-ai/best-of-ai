[
{{ $tools := where .Site.RegularPages "Section" "tools" -}}
{{ $profs := where .Site.RegularPages "Section" "professionals" -}}
{{ $cats  := where .Site.RegularPages "Section" "categories" -}}
{{ $companies := where .Site.RegularPages "Section" "companies" -}}
{{ $items := slice -}}
{{ range $profs -}}
  {{ $p := .Params -}}
  {{ $item := dict
    "type"        "profession"
    "name"        ($p.name | default .Title)
    "title"       .Title
    "slug"        ($p.slug | default .File.BaseFileName)
    "url"         .RelPermalink
    "description" ($p.description | default $p.subtitle | default "")
    "category"    "Profession"
  -}}
  {{ $items = $items | append $item -}}
{{ end -}}
{{ range $cats -}}
  {{ $p := .Params -}}
  {{ $item := dict
    "type"        "category"
    "name"        ($p.name | default .Title)
    "slug"        ($p.slug | default .File.BaseFileName)
    "url"         .RelPermalink
    "description" ($p.description | default "")
    "category"    "Category"
  -}}
  {{ $items = $items | append $item -}}
{{ end -}}
{{ range $companies -}}
  {{ $p := .Params -}}
  {{ $item := dict
    "type"        "company"
    "name"        ($p.name | default .Title)
    "slug"        ($p.slug | default .File.BaseFileName)
    "url"         .RelPermalink
    "description" ($p.description | default $p.subtitle | default "")
    "category"    "Company"
  -}}
  {{ $items = $items | append $item -}}
{{ end -}}
{{ range .Site.Taxonomies.tags -}}
  {{ $item := dict
    "type"        "tag"
    "name"        .Page.Title
    "slug"        (.Page.RelPermalink | strings.TrimPrefix "/tags/" | strings.TrimSuffix "/")
    "url"         .Page.RelPermalink
    "description" ""
    "category"    "Tag"
  -}}
  {{ $items = $items | append $item -}}
{{ end -}}
{{ range $tools -}}
  {{ $p := .Params -}}
  {{ $item := dict
    "type"        "tool"
    "name"        ($p.name        | default .Title)
    "slug"        ($p.slug        | default .File.BaseFileName)
    "url"         .RelPermalink
    "website"     ($p.website      | default "")
    "description" ($p.description | default "")
    "subtitle"    ($p.subtitle    | default "")
    "logo_url"    ($p.logo_url    | default "")
    "category"    ($p.category_name | default "")
    "price"       ($p.price       | default "Free")
    "dead"        ($p.dead        | default false)
  -}}
  {{ $items = $items | append $item -}}
{{ end -}}
{{ range $i, $item := $items -}}
{{ $item | jsonify }}{{ if lt $i (sub (len $items) 1) }},{{ end }}
{{ end -}}
]
